<% layout("layouts/boilerplate") %>

<div class="my-5">
  <h1 class="mb-4">Admin Dashboard</h1>
  <div class="row g-4">
    <div class="col-md-4">
      <div class="card p-4 shadow-sm">
        <h3>Users</h3>
        <p class="text-muted">Total registered users</p>
        <h2><%= userCount %></h2>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card p-4 shadow-sm">
        <h3>Listings</h3>
        <p class="text-muted">Total listings in the system</p>
        <h2><%= listingCount %></h2>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card p-4 shadow-sm">
        <h3>Bookings</h3>
        <p class="text-muted">Total booking records</p>
        <h2><%= bookingCount %></h2>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <a href="/admin/users" class="btn btn-primary me-2">View All Users</a>
    <a href="/admin/listings" class="btn btn-secondary">View All Listings</a>
  </div>
</div>
