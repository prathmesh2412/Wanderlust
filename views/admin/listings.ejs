<% layout("layouts/boilerplate") %>

<div class="my-5">
  <h1 class="mb-4">Admin Listings</h1>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Title</th>
          <th>Owner</th>
          <th>Location</th>
          <th>Price</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% listings.forEach((listing) => { %>
          <tr>
            <td><%= listing.title %></td>
            <td><%= listing.owner?.username || "Unknown" %></td>
            <td><%= listing.location || "-" %></td>
            <td><%= listing.price != null ? `$${listing.price}` : "-" %></td>
            <td class="text-end">
              <form action="/admin/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
